<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE contactos [
    <!-- Si añadimos el "+" significa que puede contener mas de un elemento -->
    <!ELEMENT contactos (persona+)>
    <!-- Entre paréntesis todos los subelementos del elemento padre -->
    <!ELEMENT persona (nombre, apellidos, correo, telefono, direccion)>
    <!-- A nivel de elemento, indicar que acepte cualquier tipo de texto con (#PCDATA) -->
    <!ELEMENT nombre (#PCDATA)>
    <!ELEMENT apellidos (#PCDATA)>
    <!ELEMENT correo (#PCDATA)>
    <!ELEMENT telefono (#PCDATA)>
    <!ELEMENT direccion (#PCDATA)>
    <!-- Los atributos van en !ATTLIST  -->
    <!ATTLIST persona genero CDATA #REQUIRED>
]>
<contactos>
    <persona genero="M">
        <nombre>Pepe</nombre>
        <apellidos>Ruiz</apellidos>
        <correo>pepe@mail.com</correo>
        <telefono>555123654</telefono>
        <direccion>C/Falsa 123</direccion>
    </persona>

    <persona genero="O">
        <nombre>Ana</nombre>
        <!-- CDATA se utilizar para escapar cierta información que no queremos que los programas lectores de XML -->
        <apellidos><![CDATA[Fernandez]]></apellidos>
        <correo>ana@mail.com</correo>
        <telefono>987654321</telefono>
        <direccion>C/Piruleta 32</direccion>
    </persona>    
</contactos>

 <!-- 
    XML con el elemento padre contactos;
        dentro de contactos tendrá elementos persona
        (deberá tener el atributo género)
        con los siguientes elementos:
            - nombre 
            - apellidos
            - correo
            - teléfono
            - dirección
 -->