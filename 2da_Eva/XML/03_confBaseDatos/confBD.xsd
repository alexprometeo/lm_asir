<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="configuracion_basedatos">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="base_datos">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="user" type="xs:string"></xs:element>
                            <xs:element name="password" type="xs:string"></xs:element>
                            <xs:element name="port" type="xs:integer"></xs:element>
                            <xs:element name="max_connections" type="xs:integer"></xs:element>
                            <xs:element name="access_mode" type="xs:string"></xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>